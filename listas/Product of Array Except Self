# Complejidad Temporal: O(n)
# Complejidad Espacial: O(1) [sin contar la lista de resultado requerida]
# Justificación: Se recorre la lista de entrada dos veces en bucles separados 
# de manera secuencial (no anidados), lo que resulta en un tiempo O(n), donde n 
# es la longitud de 'nums'. No se utilizó el operador de división y el espacio auxiliar 
# empleado es constante O(1), ya que las variables de apoyo que se utilizaron consumen 
# memoria fija independientemente del tamaño de la entrada.

class Solution:
    def productExceptSelf(self, nums: lista[int]) -> lista[int]:
        n = len(nums)
        res = [1] * n
        acumulado = 1
        for i in range(n):
            res[i] = acumulado
            acumulado *= nums[i]
        acumulado = 1
        for i in range(n - 1, -1, -1):
            res[i] *= acumulado
            acumulado *= nums[i]
        return res
