# Complejidad Temporal: O(n)
# Complejidad Espacial: O(n)
# Justificación: Aunque se utilizo un ciclo anidado implícito con el while, cada índice 
# de la lista entra y sale de la pila como máximo una vez. Por lo tanto, el número 
# total de operaciones es lineal O(n), donde n es la cantidad de elementos en 'temperatures'. 
# La complejidad espacial es O(n) debido a que en el peor de los casos (temperaturas 
# estrictamente decrecientes), la pila almacenará todos los índices de la entrada.

class Solution:
    def dailyTemperatures(self, temperatures: lista[int]) -> list[int]:
        n = len(temperatures)
        resultado = [0] * n
        pila = []
        for i in range(n):
            while pila and temperatures[i] > temperatures[pila[-1]]:
                indice_anterior = pila.pop()
                resultado[indice_anterior] = i - indice_anterior
            pila.append(i)
        return resultado
        

